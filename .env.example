# Copie para .env (não versionado). Valores abaixo são apenas para desenvolvimento local.
# Validação: apps/api/src/config/env.ts

NODE_ENV=development
# Prefixo API_ evita colisão: o Nx injeta o .env em todas as tarefas (ex.: dev server do Angular lê PORT)
API_HOST=0.0.0.0
API_PORT=3333
LOG_LEVEL=debug

# Docker Compose (pnpm infra:up). Portas não padrão evitam conflito com
# PostgreSQL/Redis instalados diretamente na máquina.
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=taskflow
POSTGRES_DB=taskflow
POSTGRES_PORT=55432
REDIS_PORT=56379

DATABASE_URL=postgresql://taskflow:taskflow@localhost:55432/taskflow
REDIS_URL=redis://localhost:56379

# Mailpit (SMTP falso local; UI em http://localhost:58025)
MAILPIT_SMTP_PORT=51025
MAILPIT_UI_PORT=58025

# --- Identity & Access (spec 001) ---------------------------------------------
# Origem do frontend: validação de Origin/Referer (CSRF) na API.
APP_ORIGIN=http://localhost:4200
# Chaves de assinatura do access token: JSON { "kid": "segredo" } (segredo >= 32 bytes).
# Gere segredos reais com: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Valores com "dev-only" são recusados quando NODE_ENV=production.
AUTH_ACCESS_TOKEN_KEYS='{"dev-1":"dev-only-access-token-key-change-me-0000000000"}'
AUTH_ACCESS_TOKEN_ACTIVE_KID=dev-1
CSRF_SECRET=dev-only-csrf-secret-change-me-00000000000000
LOG_PSEUDONYMIZATION_KEY=dev-only-log-pseudonymization-key-change-me-00
# localhost é contexto seguro nos navegadores: cookies Secure funcionam em http://localhost.
COOKIE_SECURE=true
# Hashes Argon2id simultâneos por processo (19 MiB cada).
PASSWORD_HASH_CONCURRENCY=4

# Worker (validadas pelo apps/worker, tarefa T19)
APP_URL=http://localhost:4200
SMTP_URL=smtp://localhost:51025
EMAIL_FROM="TaskFlow <nao-responda@taskflow.local>"
WORKER_PORT=3334

# Tempo máximo (ms) de cada verificação de dependência em /health/ready
HEALTH_CHECK_TIMEOUT_MS=2000
# "false" em acesso direto; número de proxies confiáveis atrás de reverse proxy (ex.: 1)
TRUST_PROXY=false
JSON_BODY_LIMIT=100kb
