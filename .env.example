# Copie para .env (não versionado). Valores abaixo são apenas para desenvolvimento local.
# Validação: apps/api/src/config/env.ts

NODE_ENV=development
# Prefixo API_ evita colisão: o Nx injeta o .env em todas as tarefas (ex.: dev server do Angular lê PORT)
API_HOST=0.0.0.0
API_PORT=3333
LOG_LEVEL=debug

# Docker Compose (pnpm infra:up). Portas não padrão evitam conflito com
# PostgreSQL/Redis instalados diretamente na máquina.
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=taskflow
POSTGRES_DB=taskflow
POSTGRES_PORT=55432
REDIS_PORT=56379

DATABASE_URL=postgresql://taskflow:taskflow@localhost:55432/taskflow
REDIS_URL=redis://localhost:56379

# Tempo máximo (ms) de cada verificação de dependência em /health/ready
HEALTH_CHECK_TIMEOUT_MS=2000
# "false" em acesso direto; número de proxies confiáveis atrás de reverse proxy (ex.: 1)
TRUST_PROXY=false
JSON_BODY_LIMIT=100kb
