{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "module": "esnext",
    "target": "es2022",
    "lib": ["es2022"],
    "strict": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "importHelpers": true,
    "paths": {
      "@taskflow/backend/identity/application": [
        "./libs/backend/identity/application/src/index.ts"
      ],
      "@taskflow/backend/identity/application/testing": [
        "./libs/backend/identity/application/src/testing.ts"
      ],
      "@taskflow/backend/identity/domain": ["./libs/backend/identity/domain/src/index.ts"],
      "@taskflow/backend/organizations/application": [
        "./libs/backend/organizations/application/src/index.ts"
      ],
      "@taskflow/backend/organizations/application/testing": [
        "./libs/backend/organizations/application/src/testing.ts"
      ],
      "@taskflow/backend/organizations/domain": [
        "./libs/backend/organizations/domain/src/index.ts"
      ],
      "@taskflow/backend/organizations/http": ["./libs/backend/organizations/http/src/index.ts"],
      "@taskflow/backend/organizations/infrastructure": [
        "./libs/backend/organizations/infrastructure/src/index.ts"
      ],
      "@taskflow/backend/identity/infrastructure": [
        "./libs/backend/identity/infrastructure/src/index.ts"
      ],
      "@taskflow/backend/projects/application": [
        "./libs/backend/projects/application/src/index.ts"
      ],
      "@taskflow/backend/projects/application/testing": [
        "./libs/backend/projects/application/src/testing.ts"
      ],
      "@taskflow/backend/projects/domain": ["./libs/backend/projects/domain/src/index.ts"],
      "@taskflow/backend/projects/http": ["./libs/backend/projects/http/src/index.ts"],
      "@taskflow/backend/projects/infrastructure": [
        "./libs/backend/projects/infrastructure/src/index.ts"
      ],
      "@taskflow/backend/shared/application": ["./libs/backend/shared/application/src/index.ts"],
      "@taskflow/backend/shared/application/testing": [
        "./libs/backend/shared/application/src/testing.ts"
      ],
      "@taskflow/backend/shared/http": ["./libs/backend/shared/http/src/index.ts"],
      "@taskflow/backend/shared/infrastructure": [
        "./libs/backend/shared/infrastructure/src/index.ts"
      ],
      "@taskflow/backend/shared/infrastructure/testing": [
        "./libs/backend/shared/infrastructure/src/testing.ts"
      ],
      "@taskflow/backend/shared/kernel": ["./libs/backend/shared/kernel/src/index.ts"],
      "@taskflow/contracts": ["./libs/contracts/src/index.ts"],
      "@taskflow/backend/identity/http": ["./libs/backend/identity/http/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
