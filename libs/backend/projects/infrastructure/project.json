{
  "name": "backend-projects-infrastructure",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/backend/projects/infrastructure/src",
  "projectType": "library",
  "tags": ["scope:backend", "domain:projects", "type:infrastructure"],
  "// targets": "to see all targets run: nx show project backend-projects-infrastructure --web",
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "^default"],
      "options": {
        "command": "tsc --noEmit -p libs/backend/projects/infrastructure/tsconfig.lib.json && tsc --noEmit -p libs/backend/projects/infrastructure/tsconfig.spec.json"
      }
    },
    "integration-test": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "vitest run --config vitest.integration.config.mts",
        "cwd": "{projectRoot}"
      }
    }
  }
}
