{
  "name": "backend-shared-infrastructure",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/backend/shared/infrastructure/src",
  "projectType": "library",
  "tags": ["scope:backend", "domain:shared", "type:infrastructure"],
  "// targets": "to see all targets run: nx show project backend-shared-infrastructure --web",
  "targets": {
    "integration-test": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "vitest run --config vitest.integration.config.mts",
        "cwd": "{projectRoot}"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "^default"],
      "options": {
        "command": "tsc --noEmit -p libs/backend/shared/infrastructure/tsconfig.lib.json && tsc --noEmit -p libs/backend/shared/infrastructure/tsconfig.spec.json"
      }
    },
    "prisma-generate": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["{workspaceRoot}/prisma/**/*.prisma", "{workspaceRoot}/prisma.config.ts"],
      "outputs": ["{projectRoot}/src/generated/prisma"],
      "options": {
        "command": "prisma generate"
      }
    }
  }
}
