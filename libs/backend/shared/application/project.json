{
  "name": "backend-shared-application",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/backend/shared/application/src",
  "projectType": "library",
  "tags": ["scope:backend", "domain:shared", "type:application"],
  "// targets": "to see all targets run: nx show project backend-shared-application --web",
