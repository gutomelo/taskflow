{
  "name": "contracts",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/contracts/src",
  "projectType": "library",
  "tags": ["scope:shared", "domain:shared", "type:contracts"],
  "// targets": "to see all targets run: nx show project contracts --web",
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "^default"],
      "options": {
        "command": "tsc --noEmit -p libs/contracts/tsconfig.lib.json && tsc --noEmit -p libs/contracts/tsconfig.spec.json"
      }
    }
  }
}
