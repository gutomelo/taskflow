// Schema único do TaskFlow (modular monolith, um banco PostgreSQL).
// Convenções em .claude/rules/database.md e docs/architecture/adr/0004-multi-tenancy-shared-database.md.
// - Modelos e colunas em inglês, tabelas em snake_case via @@map/@map.
// - Toda tabela tenant-scoped possui organization_id e índices que começam por ele.
// - Entidades sujeitas a edição concorrente possuem coluna `version` (optimistic locking).
//

generator client {
  provider     = "prisma-client"
  output       = "../libs/backend/shared/infrastructure/src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// --- Infraestrutura compartilhada -------------------------------------------

/// Transactional Outbox (ADR 0011): eventos de integração gravados na mesma transação
/// da alteração de negócio e publicados no BullMQ pelo worker. Payload sem dados sensíveis.
model OutboxEvent {
  id          String    @id @db.Uuid
  type        String    @db.VarChar(100)
  payload     Json
  occurredAt  DateTime  @map("occurred_at") @db.Timestamptz(3)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(3)

  @@map("outbox_events")
}

