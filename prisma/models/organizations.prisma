// Bounded context: Organizations & Teams (spec 002). Tabelas pertencem exclusivamente a este contexto.
// `user_id`, `invited_by_user_id` e `accepted_by_user_id` referenciam usuários de `identity` sem FK
// (contextos não referenciam tabelas uns dos outros — ADR 0003). Exceções (ADR 0015): `projects` →
// `organizations` e `project_members` → `memberships`; as back-relations `projects` e
// `projectParticipations` são inertes (barradas por lint).

/// Papéis organizacionais (BR-021; matriz em docs/security/authorization.md).
enum OrganizationRole {
  owner
  admin
  member
  viewer

  @@map("organization_role")
}

/// Tenant (ADR 0004). Slug único e imutável (BR-022) — CHECK de formato na migration.
model Organization {
  id                       String   @id @db.Uuid
  name                     String   @db.VarChar(80)
  slug                     String   @unique @db.VarChar(40)
  /// BR-024 (spec 006): members criam projetos; owner/admin sempre podem.
  membersCanCreateProjects Boolean  @default(true) @map("members_can_create_projects")
  /// Optimistic locking (BR-008). O lock de membership (FOR NO KEY UPDATE) não o altera.
  version                  Int      @default(1)
  createdAt                DateTime @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships Membership[]
  invitations Invitation[]
  /// ADR 0015: exigida pelo Prisma para a FK de `projects`; nunca usada pelo código de `organizations`.
  projects    Project[]

  @@map("organizations")
}

/// Usuário ↔ organização. Remoção apaga a linha (histórico no log de segurança).
model Membership {
  id             String           @id @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  role           OrganizationRole
  version        Int              @default(1)
  createdAt      DateTime         @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization          Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// ADR 0015: exigida pelo Prisma para a FK de `projects`; nunca usada pelo código de `organizations`.
  projectParticipations ProjectMember[]
  /// ADR 0015: exigida pelo Prisma para a FK do responsável em `tasks`; nunca usada por `organizations`.
  assignedTasks         Task[]

  /// Usado pelo middleware de tenant (uma consulta por requisição).
  @@unique([organizationId, userId])
  @@index([organizationId, role])
  /// Exceção documentada à regra "índices começam por organization_id": "minhas organizações".
  @@index([userId])
  @@map("memberships")
}

/// Convite nominal (BR-020). Token só como hash, emitido pelo worker; um aberto por e-mail (índice
/// único parcial na migration); papel nunca owner (CHECK).
model Invitation {
  id               String           @id @db.Uuid
  organizationId   String           @map("organization_id") @db.Uuid
  email            String           @db.VarChar(254)
  role             OrganizationRole
  invitedByUserId  String           @map("invited_by_user_id") @db.Uuid
  tokenHash        String?          @unique @map("token_hash") @db.Char(64)
  /// Último evento de envio: só ele emite o token vigente.
  deliveryEventId  String           @map("delivery_event_id") @db.Uuid
  expiresAt        DateTime         @map("expires_at") @db.Timestamptz(3)
  acceptedAt       DateTime?        @map("accepted_at") @db.Timestamptz(3)
  acceptedByUserId String?          @map("accepted_by_user_id") @db.Uuid
  revokedAt        DateTime?        @map("revoked_at") @db.Timestamptz(3)
  createdAt        DateTime         @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@map("invitations")
}
